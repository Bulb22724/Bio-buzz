{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FTC: Build and Install (Deploy)",
            "type": "shell",
            "command": "./gradlew installDebug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "windows": {
                "command": ".\\gradlew.bat installDebug"
            }
        },
        {
            "label": "FTC: Clean Project",
            "type": "shell",
            "command": "./gradlew clean",
            "problemMatcher": [],
            "windows": {
                "command": ".\\gradlew.bat clean"
            }
        },
        {
            "label": "FTC: Connect via ADB (Wi-Fi)",
            "type": "shell",
            "command": "adb connect 192.168.43.1:5555",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        }
    ]
}
